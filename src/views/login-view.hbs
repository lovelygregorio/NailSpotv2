<!--
  Login Page

  Allows users to log into the application.
  Sends credentials to the /authenticate route.
-->

{{> welcome-menu active="login"}}

<section class="section">
  
  <h1 class="title">Log in</h1>

    <!-- NORMAL LOGIN -->

  <form action="/authenticate" method="POST">
    <div class="field">
      <label class="label">Email</label> <input class="input" type="text" placeholder="Enter email" name="email">
    </div>
    <div class="field">
      <label class="label">Password</label> <input class="input" type="password" placeholder="Enter Password" name="password">
    </div>
    <div class="field is-grouped">
      <button class="button is-link">Submit</button>
    </div>
  </form>
</section>

 <!-- GOOGLE LOGIN -->
  <button
    id="google-login"
    class="button is-danger"
  >
    Login with Google
  </button>

</section>

<script type="module" src="/js/firebase-login.js"></script>