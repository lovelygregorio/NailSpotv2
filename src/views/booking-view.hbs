<!--  
  Handlebars template for the booking view in the NailSpot application. 
  This template renders a booking board where users can submit new nail booking 
  requests and view existing bookings. The template includes a form for submitting 
  new bookings, as well as a list of existing bookings with details such as salon name, 
  service requested, date, time, and booking status. 
  Users can also cancel their bookings if they have the appropriate permissions. 
  -->
           
{{> menu}}

<section class="section">
  <div class="container">

    <h1 class="title">Booking Board</h1>
    <p class="subtitle">Submit and view nail booking requests.</p>

    <form action="/bookings/add" method="POST" class="box pink-card mb-5">

      <div class="field">
        <label class="label">Your Name</label>
        <input class="input" type="text" name="customerName" placeholder="e.g. Lovely Gregorio" required>
      </div>

      <div class="field">
        <label class="label">Your Contact Details</label>
        <input class="input" type="text" name="customerContact" placeholder="Phone, email, or Instagram" required>
      </div>

      <div class="field">
        <label class="label">Salon Name</label>
        <input class="input" type="text" name="salonName" placeholder="e.g. Mint Nails" required>
      </div>

      <div class="field">
        <label class="label">Service Requested</label>
        <input class="input" type="text" name="service" placeholder="e.g. BIAB, Gel Polish, Acrylics" required>
      </div>

      <div class="field">
        <label class="label">Preferred Date</label>
        <input class="input" type="date" name="date" required>
      </div>

      <div class="field">
        <label class="label">Preferred Time</label>
        <input class="input" type="time" name="time" required>
      </div>

      <div class="field">
        <label class="label">Booking Note</label>
        <textarea class="textarea" name="notice" placeholder="e.g. Looking for weekend appointment, last-minute slot, nail repair, etc."></textarea>
      </div>

      <button class="button is-primary">
        Submit Booking Request
      </button>

    </form>

    <div class="columns is-multiline">

      {{#each bookings}}

        <div class="column is-one-third">
          <div class="box pink-card">

            <div class="level">
              <div class="level-left">
                <h2 class="title is-5">{{salonName}}</h2>
              </div>
              <div class="level-right">
                <span class="tag is-warning is-light">{{status}}</span>
              </div>
            </div>

            {{#if canViewCustomerDetails}}
              <p><strong>Customer:</strong> {{customerName}}</p>
              <p><strong>Contact:</strong> {{customerContact}}</p>
            {{/if}}

            <p><strong>Service:</strong> {{service}}</p>
            <p><strong>Date:</strong> {{date}}</p>
            <p><strong>Time:</strong> {{time}}</p>

            {{#if notice}}
              <p class="mt-3"><strong>Note:</strong> {{notice}}</p>
            {{/if}}

            {{#if canCancel}}
              <form action="/bookings/cancel/{{_id}}" method="POST" class="mt-4">
                <button class="button is-small is-warning">
                  Cancel Booking
                </button>
              </form>
            {{/if}}

          </div>
        </div>

      {{/each}}

    </div>

  </div>
</section>