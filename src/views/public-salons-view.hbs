 <!--
  Handlebars template for the public salons view in the NailSpot application. 
  This template renders a page where users can explore public nail salons in Dublin, 
  browse through a list of salons with their details, and view a map showing the locations of the salons. 
  The template includes a search form for filtering salons by name and area, and displays each salon's name, area, address, services, and notes. 
  Users can click on a salon to view more details or save it to their favourites. The map is implemented using Leaflet.js and shows markers for each salon's location based on their latitude and longitude coordinates. 
  The template uses Bulma CSS for styling and is designed to provide an informative and user-friendly experience for users looking to discover new nail salons in Dublin.  -->


{{> menu}}

<section class="section">
  <div class="container">
    <h1 class="title">Explore Dublin Nail Salons</h1>
    <p class="subtitle">Browse public nail salons and community reviews.</p>

    <div class="box mb-5">
  <form action="/public-salons" method="GET">

    <div class="columns">

      <div class="column">
        <input
          class="input"
          type="text"
          name="search"
          placeholder="Search salon..."
          value="{{search}}"
        >
      </div>

      <div class="column">
        <div class="select is-fullwidth">
          <select name="area">
            <option value="">All Areas</option>
            <option value="Central Dublin">Central Dublin</option>
            <option value="South Dublin">South Dublin</option>
            <option value="North Dublin">North Dublin</option>
            <option value="West Dublin">West Dublin</option>
          </select>
        </div>
      </div>

      <div class="column">
        <button class="button is-primary is-fullwidth">
          Search
        </button>
      </div>

    </div>

  </form>
</div>

<!-- PUBLIC SALON MAP -->
<div class="box mb-5">
  <h2 class="title is-5">Dublin Nail Salon Map</h2>

  <div  id="public-salons-map"  style="height: 250px; border-radius: 14px;"></div>
</div>

<div class="columns is-multiline">

      {{#each salons}}
        <div class="column is-half">
        <div class="box public-salon-card">
            <h2 class="title is-5">{{name}}</h2>
            {{#if image}}
  <figure class="image mb-4">
    <img src="{{image}}" alt="{{name}}"
      style=" height: 220px; width: 100%; object-fit: cover; border-radius: 14px;">
  </figure>
{{/if}}
            <p><strong>Area:</strong> {{area}}</p>
            <p><strong>Address:</strong> {{address}}</p>
            <p><strong>Services:</strong> {{services}}</p>
            <p><strong>Notes:</strong> {{notes}}</p>

            <a href="/public-salon/{{_id}}" class="button is-primary is-small mt-3">
              View Public Details
            </a>
            <a href="/salon/{{_id}}/favourite" class="button is-small is-light">
  ❤️ Save
</a>
          </div>
        </div>
      {{else}}
        <p>No public salons available yet.</p>
      {{/each}}
    </div>
  </div>
</section>

<link
  rel="stylesheet"
  href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
/>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>
  const salons = {{{salonsJson}}} || [];

  const map = L.map("public-salons-map").setView([53.3498, -6.2603], 12);

  L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
    attribution: "&copy; OpenStreetMap contributors"
  }).addTo(map);

  const bounds = [];

  salons.forEach((salon) => {

    const lat = Number(salon.latitude);
    const lng = Number(salon.longitude);

    if (lat && lng) {

      bounds.push([lat, lng]);

      L.marker([lat, lng])
        .addTo(map)
        .bindPopup(`
          <strong>${salon.name}</strong><br>
          ${salon.area}<br>
          ${salon.address}
        `);
    }
  });

  if (bounds.length > 0) {
    map.fitBounds(bounds, {
      padding: [30, 30]
    });
  }
</script>