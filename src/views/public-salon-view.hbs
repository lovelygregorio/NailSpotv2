{{> menu}}

<section class="section">
  <div class="container">

    <div class="box">
      <h1 class="title">{{salon.name}}</h1>
      <p class="subtitle">Public salon profile</p>

      <div class="columns is-multiline">

        <div class="column is-half">
          <p><strong>Area:</strong> {{salon.area}}</p>
        </div>

        <div class="column is-half">
          <p><strong>Address:</strong> {{salon.address}}</p>
        </div>

        <div class="column is-full">
          <p><strong>Services:</strong> {{salon.services}}</p>
        </div>

        <div class="column is-half">
          <p><strong>Rating:</strong> {{salon.rating}} / 5 ⭐</p>
        </div>

        <div class="column is-full">
          <p><strong>Notes:</strong></p>
          <div class="content">
            {{salon.notes}}
          </div>
        </div>

      </div>
    </div>

    <!-- MAP -->
    <div class="box">
      <h2 class="title is-5">Salon Location</h2>
      <div id="public-salon-map" style="height: 350px;"></div>
    </div>

    <!-- SERVICES -->
    <div class="box">
      <h2 class="title is-5">Services</h2>

      <table class="table is-fullwidth is-striped">
        <thead>
          <tr>
            <th>Service</th>
            <th>Category</th>
            <th>Price</th>
          </tr>
        </thead>

        <tbody>
          {{#each salon.servicesList}}
            <tr>
              <td>{{title}}</td>
              <td>{{category}}</td>
              <td>€{{price}}</td>
            </tr>
          {{else}}
            <tr>
              <td colspan="3">No services listed yet.</td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>

    <!-- REVIEWS -->
    <div class="box">
      <h2 class="title is-5">Customer Reviews</h2>

      <table class="table is-fullwidth is-striped">
        <thead>
          <tr>
            <th style="width: 20%;">Rating</th>
            <th>Comment</th>
          </tr>
        </thead>

        <tbody>
          {{#each reviews}}
            <tr>
              <td>{{rating}} / 5 ⭐</td>
              <td>{{comment}}</td>
            </tr>
          {{else}}
            <tr>
              <td colspan="2">No reviews yet.</td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>

    <!-- PUBLIC REVIEW FORM -->
    <div class="box">
      <h2 class="title is-5">Leave a Review</h2>

      <form action="/public-salon/{{salon._id}}/addreview" method="POST">

        <div class="columns is-vcentered">

          <div class="column is-2">
            <label class="label">Rating</label>

            <div class="select is-fullwidth">
              <select name="rating" required>
                <option value="">Choose rating</option>
                <option value="1">⭐</option>
                <option value="2">⭐⭐</option>
                <option value="3">⭐⭐⭐</option>
                <option value="4">⭐⭐⭐⭐</option>
                <option value="5">⭐⭐⭐⭐⭐</option>
              </select>
            </div>
          </div>

          <div class="column">
            <label class="label">Comment</label>

            <input
              class="input"
              type="text"
              name="comment"
              placeholder="Share your experience..."
              required
            >
          </div>

          <div class="column is-2">
            <label class="label">&nbsp;</label>

            <button class="button is-primary is-fullwidth">
              Submit
            </button>
          </div>

        </div>
      </form>
    </div>

  </div>
</section>

<link
  rel="stylesheet"
  href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
/>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>
  const lat = Number("{{salon.latitude}}") || 53.3498;
  const lng = Number("{{salon.longitude}}") || -6.2603;

  const map = L.map("public-salon-map").setView([lat, lng], 13);

  L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
    attribution: "&copy; OpenStreetMap contributors"
  }).addTo(map);

  L.marker([lat, lng])
    .addTo(map)
    .bindPopup("{{salon.name}}")
    .openPopup();
</script>