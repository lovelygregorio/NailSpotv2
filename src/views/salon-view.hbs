<!--
  Salon Details Page

  Displays a selected salon, allows the user to update salon details,
  view its location on a Leaflet map, add new services, and manage
  existing services linked to that salon.
-->
{{> menu}}
<section class="section">
  <div class="container">
    <div class="box">
      <h1 class="title">{{salon.name}}</h1>
      <p class="subtitle">View and edit salon details</p>

      <form action="/salon/{{salon._id}}/updatesalon" method="POST">
        <div class="columns is-multiline">
          <div class="column is-half">
            <label class="label">Salon Name</label>
            <input class="input" type="text" name="name" value="{{salon.name}}">
          </div>

          <div class="column is-half">
            <label class="label">Area</label>
            <input class="input" type="text" name="area" value="{{salon.area}}">
          </div>

          <div class="column is-full">
            <label class="label">Address</label>
            <input class="input" type="text" name="address" value="{{salon.address}}">
          </div>

          <div class="column is-half">
            <label class="label">Services</label>
            <input class="input" type="text" name="services" value="{{salon.services}}">
          </div>

          <div class="column is-half">
            <label class="label">Rating</label>
            <input class="input" type="number" name="rating" min="1" max="5" value="{{salon.rating}}">
          </div>

          <div class="column is-full">
            <label class="label">Notes</label>
            <textarea class="textarea" name="notes">{{salon.notes}}</textarea>
          </div>

          <div class="column is-half">
            <label class="label">Latitude</label>
            <input class="input" type="text" name="latitude" value="{{salon.latitude}}">
          </div>

          <div class="column is-half">
            <label class="label">Longitude</label>
            <input class="input" type="text" name="longitude" value="{{salon.longitude}}">
          </div>
        </div>

        <button class="button is-link mt-4">Update Salon</button>
      </form>
    </div>

    <div class="box">
      <h2 class="title is-5">Salon Location</h2>
      <div id="single-salon-map" style="height: 350px;"></div>
    </div>
 <div class="box">
      <h2 class="title is-5">Add Service</h2>

      <form action="/salon/{{salon._id}}/addservice" method="POST">
        <div class="columns">
          <div class="column">
            <label class="label">Service Title</label>
            <input class="input" type="text" name="title" placeholder="BIAB Refill">
          </div>

          <div class="column">
            <label class="label">Category</label>
            <input class="input" type="text" name="category" placeholder="BIAB">
          </div>

          <div class="column">
            <label class="label">Price</label>
            <input class="input" type="number" name="price" placeholder="45">
          </div>
        </div>

        <button class="button is-primary mt-3">Add Service</button>
      </form>
    </div>

    <div class="box">
      <h2 class="title is-5">Services</h2>

      <table class="table is-fullwidth is-hoverable">
        <thead>
          <tr>
            <th>Service</th>
            <th>Category</th>
            <th>Price</th>
            <th>Actions</th>
          </tr>
        </thead>

        <tbody>
          {{#each salon.servicesList}}
            <tr>
              <td><strong>{{title}}</strong></td>
              <td>{{category}}</td>
              <td>€{{price}}</td>
              <td>
                <a href="/service/{{../salon._id}}/edit/{{_id}}" class="button is-small is-warning">Edit</a>
                <a href="/salon/{{../salon._id}}/deleteservice/{{_id}}" class="button is-small is-danger">Delete</a>
              </td>
            </tr>
          {{else}}
            <tr>
              <td colspan="4">No services added yet.</td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>

    <div class="box">
      <h2 class="title is-5">Add Customer Review</h2>

      <form action="/salon/{{salon._id}}/addreview" method="POST">
        <div class="columns is-vcentered">
          <div class="column is-2">
            <label class="label">Rating</label>
            <div class="select is-fullwidth">
              <select name="rating" required>
                <option value="">Choose rating</option>
                <option value="1">⭐</option>
                <option value="2">⭐⭐</option>
                <option value="3">⭐⭐⭐</option>
                <option value="4">⭐⭐⭐⭐</option>
                <option value="5">⭐⭐⭐⭐⭐</option>
              </select>
            </div>
          </div>

          <div class="column">
            <label class="label">Comment</label>
            <input class="input" type="text" name="comment" placeholder="Write your review..." required>
          </div>

          <div class="column is-2">
            <label class="label">&nbsp;</label>
            <button class="button is-primary is-fullwidth">Add Review</button>
          </div>
        </div>
      </form>
    </div>

    <div class="box">
      <h2 class="title is-5">Customer Reviews</h2>

      <table class="table is-fullwidth is-striped">
        <thead>
          <tr>
            <th style="width: 20%;">Rating</th>
            <th>Comment</th>
            <th style="width: 15%;">Actions</th>
          </tr>
        </thead>

        <tbody>
          {{#each reviews}}
            <tr>
              <td>
                {{#if rating}}
                  {{rating}} / 5 ⭐
                {{else}}
                  No rating
                {{/if}}
              </td>

              <td>
                {{#if comment}}
                  {{comment}}
                {{else}}
                  No comment added.
                {{/if}}
              </td>

              <td>
                <a href="/salon/{{../salon._id}}/deletereview/{{_id}}" class="button is-small is-danger">
                  Delete Review
                </a>
              </td>
            </tr>
          {{else}}
            <tr>
              <td colspan="3">No reviews yet.</td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>

  </div>
</section>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>
  const lat = Number("{{salon.latitude}}") || 53.3498;
  const lng = Number("{{salon.longitude}}") || -6.2603;

  const map = L.map("single-salon-map").setView([lat, lng], 13);

  L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
    attribution: "&copy; OpenStreetMap contributors"
  }).addTo(map);

  L.marker([lat, lng]).addTo(map)
    .bindPopup("{{salon.name}}")
    .openPopup();
</script>